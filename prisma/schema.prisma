datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  email            String?           @unique
  phone            String            @unique
  passwordHash     String
  name             String
  role             String            @default("CUSTOMER") // CUSTOMER, PROVIDER, ADMIN
  adminRole        String?           @default("MASTER_ADMIN") // MASTER_ADMIN, OPERATIONS_ADMIN, VERIFICATION_ADMIN, FINANCE_ADMIN, SUPPORT_ADMIN, MODERATOR
  avatarUrl        String?
  isPhoneVerified  Boolean           @default(false)
  referralCode     String?           @unique
  referredByCode   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  providerProfile       ProviderProfile?
  serviceRequests       ServiceRequest[]      @relation("CustomerRequests")
  quotes                Quote[]               @relation("ProviderQuotes")
  sentMessages          Message[]             @relation("SentMessages")
  reviewsGiven          Review[]              @relation("AuthorReviews")
  reviewsReceived       Review[]              @relation("TargetReviews")
  notifications         Notification[]
  reportsSubmitted      Report[]              @relation("ReportedBy")
  reportsAgainst        Report[]              @relation("ReportedTarget")
  verificationRequests  VerificationRequest[]
  auditLogs             AuditLog[]            @relation("UserAuditLogs")
  communityNotices      CommunityNotice[]
  chatParticipants      ChatParticipant[]
  chatMessages          ChatMessage[]         @relation("UserChatMessages")
  authorQAs             ProductQA[]           @relation("AuthorQAs")
  answeredQAs           ProductQA[]           @relation("AnsweredQAs")
  communityPosts        CommunityPost[]
  communityComments     CommunityComment[]
  communityUpvotes      CommunityUpvote[]
  customerProfile       CustomerProfile?
  businessProfile       BusinessProfile?
  adminCustomerNotes    AdminCustomerNote[]   @relation("AdminNotes")
  productListings       ProductListing[]      @relation("UserListings")
  approvedProducts      ProductListing[]      @relation("ApprovedProducts")
  favorites             BusinessFavorite[]
  emailLogs             EmailLog[]
  deliveryProviderProfile DeliveryProviderProfile?
  customerDeliveries    DeliveryRequest[]     @relation("CustomerDeliveries")
  activityLogs          UserActivityLog[]
  customerEscrowDeals   EscrowDeal[]          @relation("CustomerEscrowDeals")
  providerEscrowDeals   EscrowDeal[]          @relation("ProviderEscrowDeals")
  disputesFiled         Dispute[]             @relation("DisputesFiled")
  disputesReceived      Dispute[]             @relation("DisputesReceived")
  productLikes          ProductLike[]
  productQuestions      ProductQuestion[]
  productReviews        ProductReview[]
}

model ProviderProfile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName        String
  slug                String             @unique
  bio                 String
  yearsExperience     Int                @default(1)
  pricingHourly       Float?
  pricingFixedStart   Float?
  serviceArea         String             // e.g. "Sakasaka, Nyohini, Choggu, All Tamale"
  verificationStatus   String             @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  logoUrl             String?
  websiteUrl          String?
  idDocumentUrl       String?
  businessCertUrl     String?
  portfolioUrls       String             @default("[]") // JSON string array
  ratingAverage       Float              @default(0.0)
  reviewCount         Int                @default(0)
  completedJobsCount  Int                @default(0)
  responseRate        Float              @default(100.0)
  responseTimeMinutes Int                @default(30)
  isPromoted          Boolean            @default(false)
  badges              String             @default("[\"PHONE_VERIFIED\"]") // JSON string array
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  services            ProviderService[]
  products            Product[]
  rentalTools         RentalTool[]
}

model Category {
  id                      String        @id @default(uuid())
  name                    String        @unique
  slug                    String        @unique
  description             String
  icon                    String
  capabilities            String        @default("[\"SERVICES\"]") // JSON string array of allowed capabilities
  verificationRequirement String        @default("NONE") // NONE, ID_VERIFIED, BUSINESS_LICENSE, PROFESSIONAL_LICENSE
  disclaimerText          String?       // Legal / Regulatory disclaimer text (e.g. for Health/Legal)
  displayOrder            Int           @default(0)
  isActive                Boolean       @default(true)
  featured                Boolean       @default(false)
  createdAt               DateTime      @default(now())

  services                Service[]
  subcategories           Subcategory[]
  offers                  UniversalOffer[]
}

model Subcategory {
  id           String    @id @default(uuid())
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  slug         String    @unique
  description  String?
  icon         String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  offers       UniversalOffer[]

  @@index([categoryId])
}

model Service {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  description String
  createdAt   DateTime @default(now())

  providers   ProviderService[]
  requests    ServiceRequest[]
}

model ProviderService {
  id          String          @id @default(uuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
}

model Location {
  id        String   @id @default(uuid())
  country   String   @default("Ghana")
  region    String   @default("Northern Region")
  city      String   @default("Tamale")
  area      String   // e.g. Sakasaka, Choggu, Nyohini
  slug      String   @unique
  createdAt DateTime @default(now())

  requests  ServiceRequest[]
}

model ServiceRequest {
  id                    String                @id @default(uuid())
  customerId            String
  customer              User                  @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  serviceId             String?
  service               Service?              @relation(fields: [serviceId], references: [id])
  customCategory        String?               // Fallback for custom / unlisted service
  tags                  String                @default("[]") // JSON string array
  locationId            String?
  location              Location?             @relation(fields: [locationId], references: [id])
  communityPost         CommunityPost?
  
  // Dual Geolocation & Live GPS
  streetAddress         String?
  landmark              String?
  latitude              Float?
  longitude             Float?
  accuracyRadius        Float?
  isLiveTrackingOptIn   Boolean               @default(false)
  
  title                 String
  description           String
  images                String                @default("[]") // JSON string array
  
  // Urgency & Scheduling
  urgency               String                @default("SAME_DAY") // EMERGENCY_ASAP, SAME_DAY, SCHEDULED, FLEXIBLE
  scheduledDateTime     DateTime?
  timezone              String                @default("Africa/Accra")
  
  // Budget & Pricing Structure
  pricingType           String                @default("OPEN_FOR_QUOTES") // FIXED, RANGE, HOURLY, OPEN_FOR_QUOTES
  budgetMin             Float?
  budgetMax             Float?
  currency              String                @default("GHS")
  
  // Guest Onboarding & Account Claiming
  isGuestPost           Boolean               @default(false)
  guestName             String?
  guestPhone            String?
  guestEmail            String?
  guestClaimToken       String?               @unique
  guestOtpCode          String?
  isVerifiedGuest       Boolean               @default(false)
  
  // Safety, Access & Privacy Settings
  accessInstructions    String?
  preferredContactMethod String               @default("WHATSAPP_SMS") // CHAT, CALL, WHATSAPP_SMS
  visibility            String                @default("PUBLIC_ALL") // PUBLIC_ALL, VERIFIED_ONLY, PRIVATE_INVITE
  
  // Lifecycle States: DRAFT, PENDING_VERIFICATION, PUBLISHED, OFFER_ACCEPTED, IN_PROGRESS, COMPLETED, CANCELLED, EXPIRED
  status                String                @default("OPEN")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  quotes                Quote[]
  reviews               Review[]
  media                 ServiceRequestMedia[]
  escrowDeals           EscrowDeal[]
}

model ServiceRequestMedia {
  id          String         @id @default(uuid())
  requestId   String
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  mediaUrl    String
  mediaType   String         // IMAGE, VIDEO, DOCUMENT
  fileName    String?
  fileSize    Int?
  createdAt   DateTime       @default(now())
}

model Quote {
  id             String      @id @default(uuid())
  requestId      String
  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId     String
  provider       User        @relation("ProviderQuotes", fields: [providerId], references: [id], onDelete: Cascade)
  price          Float
  estimatedHours Int?
  completionTime String
  message        String
  status         String      @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt      DateTime    @default(now())

  conversation   Conversation?
}

model Conversation {
  id        String   @id @default(uuid())
  quoteId   String?  @unique
  quote     Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  text           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Review {
  id         String         @id @default(uuid())
  requestId  String
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId   String
  author     User           @relation("AuthorReviews", fields: [authorId], references: [id])
  targetId   String
  target     User           @relation("TargetReviews", fields: [targetId], references: [id])
  rating     Int            // 1 to 5
  comment    String
  isApproved Boolean        @default(true)
  createdAt  DateTime       @default(now())
}

model VerificationRequest {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  idType      String             // Ghana Card, Driver License, Passport
  idNumber    String
  documentUrl String
  status      String             @default("PENDING") // PENDING, VERIFIED, REJECTED
  adminNotes  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  reporter   User     @relation("ReportedBy", fields: [reporterId], references: [id])
  targetId   String?
  target     User?    @relation("ReportedTarget", fields: [targetId], references: [id])
  reason     String
  details    String
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FeatureFlag {
  id          String   @id @default(uuid())
  name        String   @unique
  isEnabled   Boolean  @default(false)
  description String
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id])
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}

model Product {
  id            String          @id @default(uuid())
  providerId    String
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title         String
  slug          String          @unique
  description   String
  price         Float
  originalPrice Float?        // Regular compare-at price before discount
  stockQuantity Int           @default(1)
  images        String          @default("[]") // JSON string array
  category      String          // e.g. "Electronics", "Fashion & Fugu", "Electrical Supplies", "Tools"
  isAvailable   Boolean         @default(true)
  viewCount     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  qaThreads     ProductQA[]
}

model RentalTool {
  id          String          @id @default(uuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title       String
  slug        String          @unique
  description String
  dailyRate   Float
  images      String          @default("[]") // JSON string array
  category    String          // e.g. "Power Tools", "Generators", "Scaffolding & Ladders"
  isAvailable Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CommunityNotice {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String   // e.g. "Urgent Request", "Artisan Meetup", "Equipment Needed", "Job Opportunity"
  area      String   // e.g. Sakasaka, Aboabo, Nyohini
  createdAt DateTime @default(now())
}

// =========================================================================
// MULTI-ROLE CHAT & MESSAGING SUBSYSTEM MODELS
// =========================================================================

model ChatRoom {
  id        String   @id @default(uuid())
  scope     String   @default("C2B") // C2B, C2ADMIN_SUPPORT, B2ADMIN, B2B_WHOLESALE, DISPUTE_MEDIATION, LOGISTICS_COURIER, BOT_HELP
  title     String?
  productId String?
  orderId   String?
  status    String   @default("OPEN") // OPEN, TRIAGED, RESOLVED, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ChatParticipant[]
  messages     ChatMessage[]
  moderation   ModerationLog[]
}

model ChatParticipant {
  id          String    @id @default(uuid())
  roomId      String
  room        ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("BUYER") // BUYER, VENDOR, ADMIN_MEDIATOR, COURIER, BOT
  unreadCount Int       @default(0)
  lastReadAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([roomId, userId])
}

model ChatMessage {
  id             String   @id @default(uuid())
  roomId         String
  room           ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation("UserChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  attachments    String   @default("[]") // JSON string array of Cloudinary URLs
  status         String   @default("SENT") // SENT, DELIVERED, READ
  isInternalNote Boolean  @default(false) // Staff-only internal note
  createdAt      DateTime @default(now())
}

model ProductQA {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation("AuthorQAs", fields: [authorId], references: [id], onDelete: Cascade)
  question        String
  answer          String?
  answeredById    String?
  answeredBy      User?    @relation("AnsweredQAs", fields: [answeredById], references: [id], onDelete: SetNull)
  isVerifiedBuyer Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ModerationLog {
  id          String    @id @default(uuid())
  roomId      String?
  room        ChatRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  senderId    String?
  flaggedText String
  reason      String    // PHONE_MASKED, OFF_PLATFORM_PAYMENT, PROFANITY
  actionTaken String    // MASKED, BLOCKED, FLAGGED
  createdAt   DateTime  @default(now())
}

// =========================================================================
// TOP TICKER & PROMOTIONAL ANNOUNCEMENT BAR SUBSYSTEM
// =========================================================================

model TickerAnnouncement {
  id           String   @id @default(uuid())
  text         String
  tag          String   @default("ANNOUNCEMENT") // JOB_SEEKER, BUSINESS_OWNER, EXPERT_ARTISAN, EMERGENCY, PROMO, RENTAL
  badgeText    String?
  badgeColor   String   @default("emerald") // emerald, amber, indigo, purple, rose, teal, cyan
  ctaLabel     String?
  ctaUrl       String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// =========================================================================
// ENTERPRISE CUSTOMER MANAGEMENT & CRM SUBSYSTEM MODELS
// =========================================================================

enum CustomerStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  FROZEN_ESCROW
  BANNED
  ARCHIVED
}

enum VerificationTier {
  UNVERIFIED
  TIER_1_BASIC      // Phone/Email verified
  TIER_2_IDENTITY   // National ID / Passport verified
  TIER_3_ENTERPRISE // Business registration / Tax verified
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProfileVisibility {
  PUBLIC
  RESTRICTED
  PRIVATE
}

enum EscrowDealStatus {
  FUNDS_HELD_IN_VAULT
  IN_PROGRESS
  AWAITING_RELEASE
  COMPLETED
  DISPUTED
  REFUNDED
}

enum DisputeStatus {
  UNDER_REVIEW
  EVIDENCE_REQUESTED
  MEDIATION_IN_PROGRESS
  REFUND_ISSUED
  RESOLVED
}

model CustomerProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Status & Verification
  status            CustomerStatus    @default(ACTIVE)
  verificationTier  VerificationTier  @default(UNVERIFIED)
  riskLevel         RiskLevel         @default(LOW)
  riskScore         Float             @default(0.0) // 0-100 score
  
  // Default Localization & Defaults
  defaultCurrency       String            @default("GHS")
  defaultZone           String            @default("Tamale Central")
  preferredPayment      String            @default("MOMO_ESCROW")
  profileVisibility     ProfileVisibility @default(RESTRICTED)

  // Notification Preferences
  notifyInApp           Boolean           @default(true)
  notifyWhatsApp        Boolean           @default(true)
  notifySms             Boolean           @default(true)
  notifyMarketingEmail  Boolean           @default(false)
  
  // Privacy Defaults
  sharePhoneWithArtisan Boolean           @default(true)
  showNameOnReviews     Boolean           @default(true)

  // Saved Addresses
  savedAddresses        CustomerAddress[]

  // Financial Metrics Cache
  lifetimeValue     Decimal           @default(0.0) @db.Decimal(12, 2)
  totalOrdersCount  Int               @default(0)
  disputeCount      Int               @default(0)
  walletBalance     Decimal           @default(0.0) @db.Decimal(12, 2)
  rewardPoints      Int               @default(0)

  // Custom Metadata & Segmentation
  tags              String[]          @default([])
  customAttributes  Json?             // Key-value metadata
  
  // Notes & Logs
  internalNotes     AdminCustomerNote[]
  activityLogs      CustomerAuditLog[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, riskLevel])
  @@index([verificationTier])
  @@index([userId])
}

model CustomerAddress {
  id                String          @id @default(cuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  label             String          // "Home", "Workshop", "Office"
  zone              String          // "Sakasaka", "Choggu", etc.
  streetDetails     String?
  landmark          String?
  latitude          Float?
  longitude         Float?
  isDefault         Boolean         @default(false)
  createdAt         DateTime        @default(now())

  @@index([customerProfileId])
}

model UserActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType  String   // "VIEWED_STORE", "FAVORITED_ITEM", "SUBMITTED_QUOTE", "OPENED_DISPUTE", "ESCROW_DEPOSIT", "RELEASED_FUNDS"
  description String
  entityId    String?  // ID of product, service, or business
  entityType  String?  // "PRODUCT", "SERVICE", "BUSINESS", "COMMUNITY", "ESCROW"
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model EscrowDeal {
  id                String            @id @default(cuid())
  dealCode          String            @unique // e.g. "ESC-98214"
  customerId        String
  customer          User              @relation("CustomerEscrowDeals", fields: [customerId], references: [id], onDelete: Cascade)
  providerId        String
  provider          User              @relation("ProviderEscrowDeals", fields: [providerId], references: [id], onDelete: Cascade)
  serviceRequestId  String?
  serviceRequest    ServiceRequest?   @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  title             String
  amount            Decimal           @db.Decimal(12, 2)
  platformFee       Decimal           @default(0.00) @db.Decimal(12, 2)
  status            EscrowDealStatus  @default(FUNDS_HELD_IN_VAULT)
  paymentMethod     String            @default("MTN_MOMO") // MTN_MOMO, TELECEL_CASH, AIRTELTIGO
  momoRef           String?
  releasePin        String?           // 4-digit customer confirmation PIN
  milestonesJson    String            @default("[]") // JSON milestone steps
  timelineJson      String            @default("[]") // JSON events array
  
  disputes          Dispute[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([customerId, status])
  @@index([providerId, status])
}

model Dispute {
  id                String          @id @default(cuid())
  caseNumber        String          @unique // e.g. "DSP-4019"
  escrowDealId      String?
  escrowDeal        EscrowDeal?     @relation(fields: [escrowDealId], references: [id], onDelete: SetNull)
  customerId        String
  customer          User            @relation("DisputesFiled", fields: [customerId], references: [id], onDelete: Cascade)
  providerId        String
  provider          User            @relation("DisputesReceived", fields: [providerId], references: [id], onDelete: Cascade)
  amount            Decimal         @db.Decimal(12, 2)
  status            DisputeStatus   @default(UNDER_REVIEW)
  reason            String
  description       String          @db.Text
  evidenceJson      String          @default("[]") // JSON array of photo URLs
  resolutionNotes   String?         @db.Text
  adminAssignedId   String?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerId, status])
  @@index([providerId, status])
}

model AdminCustomerNote {
  id          String          @id @default(cuid())
  customerId  String
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  adminId     String
  admin       User            @relation("AdminNotes", fields: [adminId], references: [id])
  content     String
  isPinned    Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([customerId])
}

model CustomerAuditLog {
  id          String          @id @default(cuid())
  customerId  String
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  performedBy String          // Admin ID or 'SYSTEM'
  action      String          // e.g. "SUSPEND_ACCOUNT", "MANUAL_WALLET_CREDIT"
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime        @default(now())

  @@index([customerId])
}

// =========================================================================
// GUEST & REGISTERED PRODUCT LISTINGS & CLASSIFIEDS SUBSYSTEM
// =========================================================================

enum ProductListingStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  EXPIRED
  SOLD
  SUSPENDED
}

enum ItemCondition {
  BRAND_NEW
  REFURBISHED
  USED_LIKE_NEW
  USED_GOOD
  USED_FAIR
}

enum SellerType {
  REGISTERED_USER
  GUEST
}

model ProductListing {
  id               String               @id @default(cuid())
  title            String
  slug             String               @unique
  description      String               @db.Text
  category         String
  subCategory      String?
  condition        ItemCondition        @default(USED_GOOD)
  
  // Pricing
  price            Decimal              @db.Decimal(12, 2)
  originalPrice    Decimal?             @db.Decimal(12, 2)
  isNegotiable     Boolean              @default(false)
  currency         String               @default("GHS")
  
  // Stock & Inventory Control
  stockQuantity    Int                  @default(1)
  sku              String?
  variants         Json?
  inventoryStatus  String               @default("IN_STOCK") // IN_STOCK, LOW_STOCK, RENTED_OUT, SOLD_OUT
  
  // Media & Location
  images           String[]
  videoUrl         String?
  area             String               // e.g. "Sakasaka", "Tamale Central"
  deliveryOptions  String[]             // ["PICKUP", "LOCAL_DELIVERY"]
  
  // Seller Ownership
  sellerType       SellerType           @default(REGISTERED_USER)
  sellerId         String?
  seller           User?                @relation("UserListings", fields: [sellerId], references: [id], onDelete: SetNull)
  businessId       String?
  business         BusinessProfile?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  
  // Guest Seller Data (Populated if sellerType == GUEST)
  guestName        String?
  guestPhone       String?
  guestWhatsApp    String?
  guestEmail       String?
  isGuestVerified  Boolean              @default(false)
  guestAccessKey   String?              // For magic link editing
  
  // Moderation & Status
  status           ProductListingStatus @default(PENDING_APPROVAL)
  isFeatured       Boolean              @default(false)
  rejectionReason  String?
  approvedById     String?
  approvedBy       User?                @relation("ApprovedProducts", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  
  // Engagement
  likesCount       Int                  @default(0)
  viewsCount       Int                  @default(0)
  inquiriesCount   Int                  @default(0)
  discountPercent  Int?
  expiresAt        DateTime?
  
  likes            ProductLike[]
  questions        ProductQuestion[]
  reviews          ProductReview[]
  
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, sellerType])
  @@index([area, category])
}

model ProductLike {
  id        String         @id @default(cuid())
  productId String
  product   ProductListing @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

model ProductQuestion {
  id         String         @id @default(cuid())
  productId  String
  product    ProductListing @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String         @db.Text
  answer     String?        @db.Text
  answeredBy String?        // Seller or Admin ID
  answeredAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([productId])
}

model ProductReview {
  id         String         @id @default(cuid())
  productId  String
  product    ProductListing @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int            // 1 to 5
  title      String?
  comment    String         @db.Text
  photos     String[]
  isVerified Boolean        @default(false) // Verified Buyer badge
  createdAt  DateTime       @default(now())

  @@index([productId])
}

// =========================================================================
// STANDARDIZED COMMUNITY HUB & TRADE BOARD SUBSYSTEM
// =========================================================================

enum RegionZone {
  ALL_NORTHERN_GH
  SAKASAKA
  NYOHINI
  CHOGGU
  ABOABO
  DUNGU_UDS
  LAMASHEGU
  VITTIN
  GUMANI
  KALPOHIN
  CENTRAL_MARKET
  DATOYILI
  BILPELA
}

enum PostCategory {
  ALL_DISCUSSIONS
  SERVICE_CALL
  TOOL_RENTAL
  ARTISAN_MEETUP
  GRID_ALERT
  SKILL_SHARE
  RECOMMENDATION
  LOST_AND_FOUND
}

enum ItemStatus {
  OPEN_ACTIVE
  RESOLVED
  EXPIRED
}

model CommunityPost {
  id               String          @id @default(cuid())
  title            String
  content          String          @db.Text
  category         PostCategory    @default(ALL_DISCUSSIONS)
  zone             RegionZone      @default(ALL_NORTHERN_GH)
  status           ItemStatus      @default(OPEN_ACTIVE)
  isPinned         Boolean         @default(false)
  isLocked         Boolean         @default(false)
  
  // Pricing / Budget (Optional for gigs & rentals)
  budget           Decimal?        @db.Decimal(10, 2)
  currency         String          @default("GHS")
  urgency          String?         // "Immediate", "Today", "Scheduled"
  
  photos           String[]
  
  // Author Relationships
  authorId         String?
  author           User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  guestName        String?
  guestPhone       String?
  guestWhatsApp    String?
  
  // Cross-linking with Service Engine
  serviceRequestId String?         @unique
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  
  // Engagement
  upvotesCount     Int             @default(0)
  commentsCount    Int             @default(0)
  viewsCount       Int             @default(0)
  reportsCount     Int             @default(0)
  
  comments         CommunityComment[]
  upvotes          CommunityUpvote[]
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([zone, category])
  @@index([status])
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id])
  guestName String?
  content   String        @db.Text
  createdAt DateTime      @default(now())

  @@index([postId])
}

model CommunityUpvote {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  userIp    String?       // Fallback for guest upvote deduplication
  createdAt DateTime      @default(now())

  @@unique([postId, userId, userIp])
}

// =========================================================================
// ENTERPRISE MERCHANT & ARTISAN BUSINESS PORTAL SUBSYSTEM
// =========================================================================

enum BusinessType {
  SOLO_ARTISAN
  RETAIL_STORE
  EQUIPMENT_RENTAL_HUB
  CONTRACTOR_WORKSHOP
  WHOLESALE_SUPPLIER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  TIER_1_BASIC
  TIER_2_VERIFIED_ARTISAN
  TIER_3_REGISTERED_ENTERPRISE
  REJECTED
}

enum LeadStatus {
  NEW_INQUIRY
  QUOTE_SENT
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

model BusinessProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Public Identity
  businessName      String
  slug              String             @unique
  tagline           String?
  description       String             @db.Text
  businessType      BusinessType       @default(SOLO_ARTISAN)
  logoUrl           String?
  bannerUrl         String?
  
  // Location & Contact
  zone              String             // e.g., "Sakasaka", "Choggu", "Tamale Central"
  addressDetails    String?
  landmark          String?
  latitude          Float?
  longitude         Float?
  phone             String
  whatsappNumber    String
  email             String?
  businessHours     Json?              // { monday: { open: "08:00", close: "18:00", closed: false }, emergencyCallout: true }
  
  // Trust & Verification
  verificationStatus VerificationStatus @default(UNVERIFIED)
  idCardNumber      String?
  idCardPhotoUrl    String?
  businessCertUrl   String?
  tinNumber         String?
  tradeAssociation  String?
  storefrontPhotoUrl String?
  isFeatured        Boolean            @default(false)
  
  // Social & External Channels
  instagramUrl      String?
  facebookUrl       String?
  
  // Catalogs & Links
  products          ProductListing[]
  services          BusinessService[]
  rentals           ToolRentalListing[]
  quotes            ServiceQuote[]
  leads             BusinessLead[]
  
  // Metrics & Analytics Counters
  profileViews      Int                @default(0)
  whatsappClicks    Int                @default(0)
  ratingAverage     Float              @default(0.0)
  reviewsCount      Int                @default(0)

  favoritesCount    Int                @default(0)
  sharesCount       Int                @default(0)
  qrScansCount      Int                @default(0)

  favoritedBy       BusinessFavorite[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([zone, businessType])
  @@index([verificationStatus])
}

model BusinessService {
  id                String          @id @default(cuid())
  businessId        String
  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceName       String
  description       String          @db.Text
  startingPrice     Decimal?        @db.Decimal(10, 2)
  estimatedDuration String?         // e.g., "2-4 hours", "1 day"
  portfolioPhotos   String[]
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  @@index([businessId])
}

model ToolRentalListing {
  id                String          @id @default(cuid())
  businessId        String
  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title             String
  slug              String          @unique
  description       String          @db.Text
  category          String          // e.g. "Power Tools", "Generators", "Scaffolding & Heavy Equipment"
  dailyRate         Decimal         @db.Decimal(10, 2)
  weeklyRate        Decimal?        @db.Decimal(10, 2)
  securityDeposit   Decimal?        @db.Decimal(10, 2)
  operatorIncluded  Boolean         @default(false)
  images            String[]
  status            String          @default("AVAILABLE") // AVAILABLE, RENTED_OUT, MAINTENANCE, UNPUBLISHED
  isAvailable       Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessId, category])
}

model ServiceQuote {
  id                String          @id @default(cuid())
  businessId        String
  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              BusinessLead?   @relation(fields: [leadId], references: [id])
  serviceRequestId  String?
  laborCost         Decimal         @db.Decimal(10, 2)
  materialsCost     Decimal         @default(0.0) @db.Decimal(10, 2)
  totalAmount       Decimal         @db.Decimal(10, 2)
  estimatedTimeline String          // e.g. "2-3 days"
  notes             String?         @db.Text
  status            String          @default("SENT") // SENT, ACCEPTED, DECLINED
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessId])
}

model BusinessLead {
  id                String          @id @default(cuid())
  businessId        String
  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId        String?
  customerName      String
  customerPhone     String
  customerWhatsApp  String?
  serviceRequestId  String?
  status            LeadStatus      @default(NEW_INQUIRY)
  notes             String?         @db.Text
  quoteAmount       Decimal?        @db.Decimal(10, 2)
  quotes            ServiceQuote[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessId, status])
}

model SearchQueryLog {
  id          String   @id @default(cuid())
  query       String
  scope       String   @default("all")
  filters     Json?
  resultCount Int      @default(0)
  userId      String?
  userIp      String?
  createdAt   DateTime @default(now())

  @@index([query])
  @@index([resultCount])
  @@index([createdAt])
}

model BusinessFavorite {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId         String
  business           BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  notifyOnNewListing Boolean         @default(true)
  createdAt          DateTime        @default(now())

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

// =========================================================================
// FULL DELIVERY MARKETPLACE PLATFORM SUBSYSTEM MODELS
// =========================================================================

model DeliveryProviderProfile {
  id                     String              @id @default(cuid())
  userId                 String              @unique
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Verification Workflow
  verificationStatus     String              @default("PENDING") // NOT_STARTED, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, SUSPENDED
  rejectionReason        String?
  idType                 String?             // GHANA_CARD, PASSPORT, DRIVERS_LICENSE
  idNumber               String?
  idDocumentUrl          String?
  selfieUrl              String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  dateOfBirth            DateTime?
  residentialAddress     String?
  
  // Live Status & GPS Location
  isOnline               Boolean             @default(false)
  currentLatitude        Float?
  currentLongitude       Float?
  lastLocationUpdate     DateTime?
  activeVehicleId        String?
  
  // Performance & Financial Metrics
  ratingAverage          Float               @default(5.0)
  ratingCount            Int                 @default(0)
  completedDeliveriesCount Int               @default(0)
  cancelledDeliveriesCount Int               @default(0)
  walletBalance          Decimal             @default(0.0) @db.Decimal(12, 2)
  pendingBalance         Decimal             @default(0.0) @db.Decimal(12, 2)
  totalEarnings          Decimal             @default(0.0) @db.Decimal(12, 2)
  
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  vehicles               DeliveryVehicle[]
  assignedDeliveries     DeliveryRequest[]   @relation("AssignedProviderDeliveries")
  withdrawals            DeliveryWithdrawal[]
  ratings                DeliveryRating[]    @relation("ProviderRatings")

  @@index([verificationStatus, isOnline])
}

model DeliveryVehicle {
  id                   String                  @id @default(cuid())
  providerId           String
  provider             DeliveryProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  
  vehicleType          String                  // BICYCLE, MOTORCYCLE, TRICYCLE, CAR, PICKUP, VAN, TRUCK
  make                 String
  model                String
  year                 Int?
  plateNumber          String?
  color                String?
  photoUrl             String?
  registrationDocUrl   String?
  insuranceDocUrl      String?
  verificationStatus   String                  @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason      String?
  
  createdAt            DateTime                @default(now())

  @@index([providerId, vehicleType])
}

model DeliveryRequest {
  id                   String                   @id @default(cuid())
  trackingNumber       String                   @unique
  customerId           String
  customer             User                     @relation("CustomerDeliveries", fields: [customerId], references: [id], onDelete: Cascade)
  businessAccountId    String?
  batchId              String?
  
  // Pickup Details
  pickupAddress        String
  pickupLatitude       Float
  pickupLongitude      Float
  pickupContactName    String
  pickupContactPhone   String
  
  // Destination Details
  destinationAddress   String
  destinationLatitude  Float
  destinationLongitude Float
  recipientName        String
  recipientPhone       String
  
  // Package Specifications
  packageCategory      String                   // DOCUMENTS, FOOD, CLOTHING, ELECTRONICS, GROCERIES, HOUSEHOLD, BUSINESS_GOODS, AGRICULTURAL, OTHER
  packageDescription   String
  packageWeightKg      Float                    @default(1.0)
  packageSize          String                   @default("MEDIUM") // SMALL, MEDIUM, LARGE, HEAVY_BULK
  packageQuantity      Int                      @default(1)
  specialInstructions  String?
  prohibitedItemsConfirmed Boolean              @default(true)
  requiredVehicleType  String                   @default("ANY") // ANY, BICYCLE, MOTORCYCLE, TRICYCLE, CAR, PICKUP, VAN, TRUCK
  
  // Matching & Assignment
  assignedProviderId   String?
  assignedProvider     DeliveryProviderProfile? @relation("AssignedProviderDeliveries", fields: [assignedProviderId], references: [id], onDelete: SetNull)
  assignedVehicleId    String?
  
  // Financial Ledger & Rates
  estimatedDistanceKm  Float
  estimatedDurationMins Int
  deliveryFee          Decimal                  @db.Decimal(12, 2)
  platformCommission   Decimal                  @db.Decimal(12, 2)
  providerEarnings     Decimal                  @db.Decimal(12, 2)
  paymentMethod        String                   @default("MOBILE_MONEY") // MOBILE_MONEY, CARD, CASH, WALLET
  paymentStatus        String                   @default("PENDING") // PENDING, PAID, ESCROW_HELD, CASH_ON_DELIVERY
  
  // Security & Proof of Delivery OTP
  deliveryPin          String                   // 4-digit PIN OTP
  status               String                   @default("REQUESTED") // REQUESTED, SEARCHING_FOR_PROVIDER, PROVIDER_ASSIGNED, PROVIDER_ARRIVING, AT_PICKUP, PACKAGE_COLLECTED, IN_TRANSIT, ARRIVING_AT_DESTINATION, DELIVERED, COMPLETED, CANCELLED_BY_CUSTOMER, CANCELLED_BY_PROVIDER, FAILED, DISPUTED
  proofPhotoUrl        String?
  cancellationReason   String?
  
  // Lifecycle Timestamps
  acceptedAt           DateTime?
  collectedAt          DateTime?
  deliveredAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  statusHistory        DeliveryStatusLog[]
  messages             DeliveryMessage[]
  dispute              DeliveryDispute?
  rating               DeliveryRating?

  @@index([status, customerId])
  @@index([assignedProviderId, status])
}

model DeliveryStatusLog {
  id                   String           @id @default(cuid())
  deliveryId           String
  delivery             DeliveryRequest  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status               String
  note                 String?
  actorId              String?
  actorRole            String?          // CUSTOMER, PROVIDER, ADMIN, SYSTEM
  createdAt            DateTime         @default(now())

  @@index([deliveryId])
}

model DeliveryMessage {
  id                   String           @id @default(cuid())
  deliveryId           String
  delivery             DeliveryRequest  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  senderId             String
  senderName           String
  text                 String
  isRead               Boolean          @default(false)
  createdAt            DateTime         @default(now())

  @@index([deliveryId])
}

model DeliveryPricingRule {
  id                   String           @id @default(cuid())
  city                 String           @default("Tamale")
  country              String           @default("Ghana")
  vehicleType          String           // BICYCLE, MOTORCYCLE, TRICYCLE, CAR, PICKUP, VAN, TRUCK
  baseFee              Float            @default(10.0)
  perKmFee             Float            @default(2.5)
  minFee               Float            @default(10.0)
  weightFeePerKg       Float            @default(1.5)
  commissionPercentage Float            @default(15.0)
  isActive             Boolean          @default(true)
  updatedAt            DateTime         @updatedAt

  @@unique([city, vehicleType])
}

model DeliveryWithdrawal {
  id                   String                  @id @default(cuid())
  providerId           String
  provider             DeliveryProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount               Decimal                 @db.Decimal(12, 2)
  paymentMethod        String                  // MOBILE_MONEY, BANK_TRANSFER
  accountName          String
  accountNumber        String
  networkOrBank        String                  // MTN, Telecel, AT, GCB, Ecobank
  status               String                  @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED
  adminNote            String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([providerId, status])
}

model DeliveryRating {
  id                   String                  @id @default(cuid())
  deliveryId           String                  @unique
  delivery             DeliveryRequest         @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  customerId           String
  providerId           String
  provider             DeliveryProviderProfile @relation("ProviderRatings", fields: [providerId], references: [id], onDelete: Cascade)
  rating               Int                     // 1 to 5
  comment              String?
  createdAt            DateTime                @default(now())
}

model DeliveryDispute {
  id                   String           @id @default(cuid())
  deliveryId           String           @unique
  delivery             DeliveryRequest  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  raisedBy             String           // CUSTOMER, PROVIDER
  reason               String
  details              String
  status               String           @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED_REFUND, RESOLVED_DISMISSED
  resolutionNote       String?
  createdAt            DateTime         @default(now())
}

model DeliveryBatch {
  id                   String           @id @default(cuid())
  businessUserId       String
  title                String
  totalItems           Int
  status               String           @default("CREATED")
  createdAt            DateTime         @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // e.g. "true", "false", JSON string
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model SystemIncident {
  id           String    @id @default(cuid())
  serviceName  String    // e.g. "Database", "Mobile Money", "SMS Gateway"
  severity     String    @default("WARNING") // CRITICAL, WARNING, INFO
  title        String
  errorMessage String
  failureCount Int       @default(1)
  status       String    @default("ACTIVE") // ACTIVE, INVESTIGATING, RESOLVED
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum EmailCategory {
  AUTHENTICATION
  GUEST_VERIFICATION
  MARKETPLACE
  SERVICE_GIG
  RENTAL
  SUPPORT_DISPUTE
  ADMIN_ALERT
  SECURITY
  SYSTEM_NOTIFICATIONS
}

model EmailLog {
  id                String        @id @default(cuid())
  recipientEmail    String
  recipientName     String?
  senderEmail       String
  subject           String
  templateName      String
  category          EmailCategory @default(SYSTEM_NOTIFICATIONS)
  status            EmailStatus   @default(QUEUED)
  provider          String        // "resend", "brevo", "smtp", "mock"
  providerMessageId String?       // External API message ID
  
  // Payload & Troubleshooting
  templateData      String?       // JSON string of variables passed
  errorMessage      String?
  retryCount        Int           @default(0)
  
  // Relations
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([recipientEmail])
  @@index([status, category])
  @@index([createdAt])
}

model UniversalOffer {
  id                    String        @id @default(cuid())
  providerId            String
  categoryId            String
  category              Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId         String?
  subcategory           Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  
  title                 String
  slug                  String        @unique
  description           String        @db.Text
  
  // Transaction Type: PRODUCT_PURCHASE, SERVICE_BOOKING, QUOTE_REQUEST, RENTAL, APPOINTMENT, DELIVERY_REQUEST, EVENT_TICKET, COURSE_ENROLLMENT, SUBSCRIPTION, CONSULTATION, ORDER, CUSTOM_REQUEST
  transactionType       String        @default("SERVICE_BOOKING")
  
  price                 Decimal       @db.Decimal(12, 2)
  compareAtPrice        Decimal?      @db.Decimal(12, 2)
  pricingUnit           String        @default("FIXED") // FIXED, PER_HOUR, PER_DAY, PER_ITEM, QUOTE_BASED
  currency              String        @default("GHS")
  
  imagesJson            String        @default("[]") // JSON string array of image URLs
  locationCity          String        @default("Tamale")
  locationRegion        String        @default("Northern Region")
  serviceRadiusKm       Float         @default(25.0)
  isOnlineOnly          Boolean       @default(false)
  stockQuantity         Int           @default(1)
  availabilityJson      String?       // JSON schedule string
  verificationRequired  String        @default("NONE")
  
  status                String        @default("ACTIVE") // ACTIVE, PENDING_REVIEW, ARCHIVED
  ratingAverage         Float         @default(0.0)
  reviewCount           Int           @default(0)
  
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  transactions          UniversalTransaction[]

  @@index([categoryId, transactionType])
  @@index([locationCity, status])
}

model UniversalTransaction {
  id                    String          @id @default(cuid())
  transactionNumber     String          @unique
  customerId            String
  providerId            String
  offerId               String?
  offer                 UniversalOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  
  transactionType       String          // PRODUCT_PURCHASE, SERVICE_BOOKING, QUOTE_REQUEST, RENTAL, APPOINTMENT, DELIVERY_REQUEST, EVENT_TICKET, SUBSCRIPTION
  status                String          @default("CREATED") // CREATED, PAYMENT_PENDING, CONFIRMED, PROCESSING, READY, DISPATCHED, DELIVERED, COMPLETED, CANCELLED, REFUNDED, DISPUTED
  
  amount                Decimal         @db.Decimal(12, 2)
  commissionAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  platformFee           Decimal         @default(0.00) @db.Decimal(12, 2)
  paymentMethod         String          @default("MOBILE_MONEY") // MOBILE_MONEY, CARD, CASH, WALLET
  paymentStatus         String          @default("PENDING") // PENDING, PAID, REFUNDED, ESCROW_HELD
  
  detailsJson           String?         @db.Text // Dynamic payload JSON string (dates, addresses, notes)
  
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([customerId])
  @@index([providerId, status])
}

model SearchQueryTelemetry {
  id                String    @id @default(uuid())
  query             String
  normalizedQuery   String
  userZone          String?   // e.g. "Sakasaka", "Choggu", "Tamale"
  deviceType        String    @default("WEB") // WEB, MOBILE_ANDROID, MOBILE_IOS
  hitsCount         Int       @default(0)
  productsCount     Int       @default(0)
  artisansCount     Int       @default(0)
  rentalsCount      Int       @default(0)
  communityCount    Int       @default(0)
  processingTimeMs  Int       @default(0)
  userId            String?
  ipHash            String?
  createdAt         DateTime  @default(now())

  @@index([query])
  @@index([normalizedQuery])
  @@index([createdAt])
  @@index([userZone])
  @@index([hitsCount])
}
